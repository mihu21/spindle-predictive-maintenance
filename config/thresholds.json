{
  "project": {
    "name": "Spindle Predictive Maintenance",
    "threshold_source": "Inferred from the supplied manufacturer-labelled dataset; verify against the official machine manual before production use",
    "threshold_comparison": "greater_than"
  },
  "monitoring": {
    "ewma_alpha": 0.1,
    "history_size": 1440,
    "forecast_window": 1440,
    "minimum_forecast_points": 1440,
